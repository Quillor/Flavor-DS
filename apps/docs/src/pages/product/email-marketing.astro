---
import DocsShell from '../../layouts/DocsShell.astro';
import TemplateFrame from '../../components/TemplateFrame.astro';
import { productNav } from '../../product/productNav';

const extraStrings = {
  preheader:     { en: 'Fresh flavors for your next launch — Flavor 2.0 is here.', es: 'Sabores frescos para tu próximo lanzamiento: llegó Flavor 2.0.', zh: '为您的下一次发布带来新风味——Flavor 2.0 来了。', de: 'Frische Aromen für Ihren nächsten Launch – Flavor 2.0 ist da.', ar: 'نكهات جديدة لإطلاقك القادم — وصل Flavor 2.0.' },
  viewInBrowser: { en: 'View in browser', es: 'Ver en el navegador', zh: '在浏览器中查看', de: 'Im Browser ansehen', ar: 'عرض في المتصفح' },
  heroHeadline:  { en: 'Make it taste like your brand', es: 'Que sepa a tu marca', zh: '让它更有品牌风味', de: 'Damit es nach Ihrer Marke schmeckt', ar: 'اجعلها بنكهة علامتك التجارية' },
  heroBody:      { en: 'Flavor 2.0 ships adaptive color, four type ramps, and density modes — everything you need to launch faster with a consistent look on every surface.', es: 'Flavor 2.0 incluye color adaptable, cuatro escalas tipográficas y modos de densidad: todo lo que necesitas para lanzar más rápido con un aspecto coherente en cada superficie.', zh: 'Flavor 2.0 带来自适应色彩、四套字阶和密度模式——助您在每个界面上以一致的外观更快发布。', de: 'Flavor 2.0 bringt adaptive Farben, vier Typo-Skalen und Dichtemodi – alles, was Sie brauchen, um schneller und überall einheitlich zu launchen.', ar: 'يقدم Flavor 2.0 ألوانًا متكيفة وأربعة سلالم خطية وأوضاع كثافة — كل ما تحتاجه لإطلاق أسرع بمظهر متسق على كل واجهة.' },
  feature1Title: { en: 'Adaptive color', es: 'Color adaptable', zh: '自适应色彩', de: 'Adaptive Farben', ar: 'ألوان متكيفة' },
  feature1Body:  { en: 'Semantic tokens resolve per theme, so campaigns match the product in light and dark.', es: 'Los tokens semánticos se resuelven por tema, así las campañas coinciden con el producto en claro y oscuro.', zh: '语义令牌按主题解析，让营销内容在浅色与深色模式下都与产品一致。', de: 'Semantische Tokens lösen sich pro Theme auf – Kampagnen passen in Hell und Dunkel zum Produkt.', ar: 'تُحل الرموز الدلالية حسب السمة، فتتطابق الحملات مع المنتج في الوضعين الفاتح والداكن.' },
  feature2Title: { en: 'Density modes', es: 'Modos de densidad', zh: '密度模式', de: 'Dichtemodi', ar: 'أوضاع الكثافة' },
  feature2Body:  { en: 'Compact, cozy, or comfortable — one toggle retunes spacing across every component.', es: 'Compacto, medio o cómodo: un solo ajuste recalibra el espaciado de todos los componentes.', zh: '紧凑、适中或宽松——一个开关即可调整所有组件的间距。', de: 'Kompakt, gemütlich oder komfortabel – ein Schalter stimmt die Abstände aller Komponenten neu ab.', ar: 'مضغوط أو متوسط أو مريح — مفتاح واحد يعيد ضبط المسافات في كل مكوّن.' },
};
---
<DocsShell title="HTML email · Marketing" nav={productNav}>
  <h1 style="font-family: var(--font-display); font-size: var(--font-size-9);">HTML email · Marketing</h1>
  <p style="color: var(--text-secondary); max-inline-size: 640px;">
    A 600px table-based marketing email: hero image, display headline, bulletproof CTA,
    and a two-column feature row that stacks on small clients. Previewed with live semantic tokens.
  </p>

  <TemplateFrame title="email-marketing" extraStrings={extraStrings} native={false}>
    <div class="em-canvas">
      <span class="em-preheader" data-i18n="preheader">Fresh flavors for your next launch — Flavor 2.0 is here.</span>
      <table role="presentation" class="em-shell" cellpadding="0" cellspacing="0">
        <tr>
          <td class="em-topbar">
            <a href="#" class="em-mutedlink" data-hit data-i18n="viewInBrowser">View in browser</a>
          </td>
        </tr>
        <tr>
          <td class="em-header">
            <img src="/brand/logo-horizontal-color.svg" alt="Flavor" height="28" />
          </td>
        </tr>
        <tr>
          <td>
            <img src="/photography/texture.jpg" alt="" class="em-hero" />
          </td>
        </tr>
        <tr>
          <td class="em-body">
            <h1 class="em-headline" data-i18n="heroHeadline">Make it taste like your brand</h1>
            <p class="em-copy" data-i18n="heroBody">Flavor 2.0 ships adaptive color, four type ramps, and density modes — everything you need to launch faster with a consistent look on every surface.</p>
            <div class="em-cta-row">
              <a href="#" class="em-cta" data-i18n="shopNow">Shop now</a>
            </div>
          </td>
        </tr>
        <tr>
          <td class="em-features">
            <table role="presentation" cellpadding="0" cellspacing="0" class="em-features-table">
              <tr>
                <td class="em-col">
                  <img src="/photography/product.jpg" alt="" class="em-col-img" />
                  <h2 class="em-col-title" data-i18n="feature1Title">Adaptive color</h2>
                  <p class="em-col-copy" data-i18n="feature1Body">Semantic tokens resolve per theme, so campaigns match the product in light and dark.</p>
                  <a href="#" class="em-textlink" data-hit data-i18n="learnMore">Learn more</a>
                </td>
                <td class="em-col">
                  <img src="/photography/collaboration.jpg" alt="" class="em-col-img" />
                  <h2 class="em-col-title" data-i18n="feature2Title">Density modes</h2>
                  <p class="em-col-copy" data-i18n="feature2Body">Compact, cozy, or comfortable — one toggle retunes spacing across every component.</p>
                  <a href="#" class="em-textlink" data-hit data-i18n="learnMore">Learn more</a>
                </td>
              </tr>
            </table>
          </td>
        </tr>
        <tr>
          <td class="em-divider-cell"><hr class="em-divider" /></td>
        </tr>
        <tr>
          <td class="em-footer">
            <p class="em-footer-line">Flavor Inc. · 428 Market Street, Suite 12 · San Francisco, CA 94111</p>
            <p class="em-footer-line">
              <a href="#" class="em-mutedlink" data-hit data-i18n="help">Help</a>
              <span aria-hidden="true"> · </span>
              <a href="#" class="em-mutedlink" data-hit data-i18n="unsubscribe">Unsubscribe</a>
            </p>
          </td>
        </tr>
      </table>
    </div>
  </TemplateFrame>

  <div class="fds-alert" data-variant="info" role="note" style="margin-block-start: var(--space-4);">
    <span aria-hidden="true">ℹ️</span>
    <div>
      <p class="fds-alert-title" style="margin:0;">Preview only</p>
      This preview renders live semantic tokens. Production export inlines the resolved hex
      values for the chosen theme, since email clients cannot read CSS custom properties.
    </div>
  </div>

  <style>
    .em-canvas {
      background: var(--surface-tint);
      padding: var(--space-7) var(--space-4);
      display: flex; flex-direction: column; align-items: center;
    }
    .em-preheader {
      display: none;
    }
    .em-shell {
      inline-size: 600px; max-inline-size: 100%;
      background: var(--surface-1);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-container);
      overflow: hidden;
      border-collapse: separate; border-spacing: 0;
    }
    .em-topbar { padding: var(--space-3) var(--space-6); text-align: center; background: var(--surface-tint); font-size: var(--font-size-1); }
    .em-header { padding: var(--space-5) var(--space-6); text-align: center; }
    .em-hero { display: block; inline-size: 100%; block-size: 220px; object-fit: cover; }
    .em-body { padding: var(--space-7) var(--space-7) var(--space-6); text-align: center; }
    .em-headline { font-family: var(--font-display); font-size: var(--font-size-8); line-height: var(--line-height-8); margin: 0 0 var(--space-4); color: var(--text-primary); }
    .em-copy { color: var(--text-secondary); font-size: var(--font-size-3); line-height: var(--line-height-4); margin: 0 0 var(--space-6); }
    .em-cta-row { text-align: center; }
    .em-cta {
      display: inline-block;
      background: var(--accent-bg); color: var(--accent-fg);
      font-weight: 700; font-size: var(--font-size-3);
      text-decoration: none;
      padding: var(--space-4) var(--space-7);
      border-radius: var(--radius-media);
    }
    .em-features { padding: 0 var(--space-5) var(--space-6); }
    .em-features-table { inline-size: 100%; border-collapse: collapse; }
    .em-col { inline-size: 50%; padding: var(--space-3); vertical-align: top; text-align: start; }
    .em-col-img { display: block; inline-size: 100%; block-size: 120px; object-fit: cover; border-radius: var(--radius-media); }
    .em-col-title { font-family: var(--font-display); font-size: var(--font-size-4); margin: var(--space-3) 0 var(--space-2); }
    .em-col-copy { color: var(--text-secondary); font-size: var(--font-size-2); line-height: var(--line-height-3); margin: 0 0 var(--space-2); }
    .em-textlink { color: var(--text-accent); font-weight: 600; font-size: var(--font-size-2); text-decoration: none; }
    .em-divider-cell { padding: 0 var(--space-6); }
    .em-divider { border: none; border-block-start: 1px solid var(--border-default); margin: 0; }
    .em-footer { padding: var(--space-5) var(--space-6) var(--space-6); text-align: center; }
    .em-footer-line { color: var(--text-tertiary); font-size: var(--font-size-1); margin: 0 0 var(--space-2); }
    .em-mutedlink { color: var(--text-tertiary); text-decoration: underline; }

    @container (max-width: 480px) {
      .em-canvas { padding: var(--space-4) var(--space-2); }
      .em-col { display: block; inline-size: 100%; }
      .em-headline { font-size: var(--font-size-6); line-height: var(--line-height-6); }
      .em-body { padding: var(--space-6) var(--space-5); }
    }
  </style>
</DocsShell>
