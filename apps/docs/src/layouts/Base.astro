---
import meta from '@flavor-ds/tokens/dist/meta.json';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@flavor-ds/tokens/dist/flavor.css';
import '@flavor-ds/ui/css';
import '@flavor-ds/ui/platform.css';
import ThemeSwitcher from '../components/ThemeSwitcher';
import { siteNav } from '../siteNav';

interface Props { title: string; description?: string }
const { title, description = 'Flavor DS — an agent-ready design system delivered via MCP.' } = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href;
const groupActive = (g: { items: { href: string }[] }) =>
  g.items.some((i) => (i.href === '/' ? path === '/' : path.startsWith(i.href)));
---
<!doctype html>
<html lang="en" data-hue="brand" data-sat="regular" data-mode="light" data-contrast="aa" data-bg="primary" data-radius="rounded" data-density="regular" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/brand/logo-square-color.svg" type="image/svg+xml" />
    <title>{title} · Flavor DS</title>
    <meta name="description" content={description} />
    <script is:inline define:vars={{ fontPairs: meta.fontPairs }}>
      // Apply saved theme (incl. Google Fonts pair) before first paint.
      try {
        const s = JSON.parse(localStorage.getItem('flavor-theme') || 'null');
        if (s) {
          const el = document.documentElement;
          // A saved pair that no longer exists (the type pairings were revised) would set an
          // attribute nothing matches: the CSS falls back to the default but the switcher would
          // still show the dead value. Drop it so state and UI agree.
          if (s.font && !fontPairs[s.font]) delete s.font;
          for (const [k, attr] of [['hue','data-hue'],['sat','data-sat'],['mode','data-mode'],['contrast','data-contrast'],['density','data-density'],['font','data-font'],['bg','data-bg'],['radius','data-radius'],['dir','dir']]) {
            if (s[k]) el.setAttribute(attr, s[k]);
          }
          if (s.font && s.font !== 'flavor' && fontPairs[s.font]) {
            const link = document.createElement('link');
            link.id = 'flavor-font-' + s.font;
            link.rel = 'stylesheet';
            link.href = fontPairs[s.font].googleCss;
            document.head.appendChild(link);
          }
        } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          document.documentElement.setAttribute('data-mode', 'dark');
        }
      } catch {}
    </script>
    <style is:global>
      body { margin: 0; min-height: 100vh; }
      .site-shell { display: flex; min-height: 100vh; }
      .site-sidebar {
        inline-size: 250px; flex-shrink: 0;
        background: var(--surface-1);
        border-inline-end: 1px solid var(--border-subtle);
        display: flex; flex-direction: column;
        position: sticky; inset-block-start: 0;
        block-size: 100vh; overflow-y: auto;
        padding: var(--space-4);
        box-sizing: border-box;
      }
      .site-logo { display: flex; align-items: center; gap: var(--space-3); text-decoration: none; color: var(--text-primary); font-family: var(--font-display); font-weight: 700; font-size: var(--font-size-5); padding: var(--space-2) var(--space-3) var(--space-4); }
      .site-nav-group { border: none; margin: 0; padding: 0; }
      .site-nav-group summary {
        list-style: none; cursor: pointer;
        font-size: var(--font-size-1); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
        color: var(--text-tertiary);
        padding: var(--space-3) var(--space-3) var(--space-1);
        display: flex; justify-content: space-between; align-items: center;
      }
      .site-nav-group summary::after { content: '▸'; transition: transform var(--duration-2) var(--ease-standard); font-size: 9px; }
      .site-nav-group[open] summary::after { transform: rotate(90deg); }
      .site-nav-sub { margin-inline-start: var(--space-3); border-inline-start: 1px solid var(--border-subtle); padding-inline-start: var(--space-2); }
      .site-nav-sub summary { list-style: none; cursor: pointer; font-size: var(--font-size-1); color: var(--text-tertiary); padding: var(--space-1) var(--space-3); display: flex; justify-content: space-between; align-items: center; }
      .site-nav-sub summary::-webkit-details-marker { display: none; }
      .site-nav-sub summary::after { content: '▸'; font-size: 9px; transition: transform var(--duration-2) var(--ease-standard); }
      .site-nav-sub[open] summary::after { transform: rotate(90deg); }
      .site-nav-sub-group { padding-block-start: var(--space-1); }
      .site-nav-sub-label { display: block; font-size: var(--font-size-1); font-weight: 600; color: var(--text-tertiary); padding: var(--space-2) var(--space-3) var(--space-1); }
      .site-nav-sub-link { display: block; font-size: var(--font-size-2); padding-block: var(--space-1); }
      .site-content { flex: 1; min-inline-size: 0; }
      .site-topbar {
        display: flex; align-items: center; justify-content: flex-end; gap: var(--space-3);
        padding: var(--space-3) var(--space-6);
        border-block-end: 1px solid var(--border-subtle);
        background: var(--surface-1);
        position: sticky; inset-block-start: 0; z-index: 40;
      }
      .site-menu-btn { display: none; }
      @media (max-width: 900px) {
        .site-sidebar { position: fixed; inset-block: 0; inset-inline-start: 0; z-index: 60; transform: translateX(-100%); transition: transform var(--duration-3) var(--ease-standard); }
        [dir="rtl"] .site-sidebar { transform: translateX(100%); }
        .site-sidebar.open { transform: translateX(0); }
        .site-menu-btn { display: inline-flex; margin-inline-end: auto; }
        .site-scrim { position: fixed; inset: 0; background: rgb(0 0 0 / 0.4); z-index: 50; display: none; }
        .site-scrim.open { display: block; }
      }
      .docs-main { padding: var(--space-8); max-inline-size: 1040px; box-sizing: border-box; }
      @media (max-width: 800px) { .docs-main { padding: var(--space-5); } }
    </style>
  </head>
  <body class="fds-app">
    <div class="site-shell">
      <aside class="site-sidebar" id="site-sidebar" aria-label="Site navigation">
        <a class="site-logo" href="/">
          <img src="/brand/logo-square-color.svg" alt="" width="30" height="30" />
          <span>Flavor <span style="font-weight:400;color:var(--text-accent)">DS</span></span>
        </a>
        <nav style="display:flex; flex-direction:column; gap: var(--space-1);">
          {siteNav.map((g) => (
            <details class="site-nav-group" open={groupActive(g)}>
              <summary>{g.group}</summary>
              {g.items.map((i) => (
                <>
                  <a class="fds-nav-link" style="display:block;" href={i.href} aria-current={isCurrent(i.href) ? 'page' : undefined}>{i.label}</a>
                  {i.children && (
                    <details class="site-nav-sub" open={path.startsWith(i.href) && path !== i.href}>
                      <summary>{i.children.reduce((n, c) => n + c.items.length, 0)} components</summary>
                      {i.children.map((c) => (
                        <div class="site-nav-sub-group">
                          <span class="site-nav-sub-label">{c.group}</span>
                          {c.items.map((s) => (
                            <a class="fds-nav-link site-nav-sub-link" href={s.href} aria-current={isCurrent(s.href) ? 'page' : undefined}>{s.label}</a>
                          ))}
                        </div>
                      ))}
                    </details>
                  )}
                </>
              ))}
            </details>
          ))}
        </nav>
      </aside>
      <div class="site-scrim" id="site-scrim"></div>
      <div class="site-content">
        <header class="site-topbar">
          <button class="fds-button site-menu-btn" data-variant="outline" data-size="sm" aria-label="Open navigation" aria-controls="site-sidebar"
            onclick="document.getElementById('site-sidebar').classList.toggle('open');document.getElementById('site-scrim').classList.toggle('open')">☰</button>
          <ThemeSwitcher client:load />
        </header>
        <slot />
      </div>
    </div>
    <script is:inline>
      document.getElementById('site-scrim')?.addEventListener('click', () => {
        document.getElementById('site-sidebar').classList.remove('open');
        document.getElementById('site-scrim').classList.remove('open');
      });
    </script>
    <script>
      // Keyboard + focus contracts for the CSS-first components (menu, tabs, dialog,
      // listbox, tooltip). Same module the React wrappers use; upgrades any subtree
      // rendered later via document.dispatchEvent(new Event('fds:upgrade')).
      import { upgrade } from '@flavor-ds/ui/behaviors';
      import * as typeScale from '@flavor-ds/ui/type-scale';
      upgrade(document);
      document.addEventListener('fds:upgrade', () => upgrade(document));
      // Dynamic type module for inline (define:vars) scripts that cannot import bare specifiers.
      (window as any).FlavorTypeScale = typeScale;
      document.dispatchEvent(new Event('fds:type-scale'));
    </script>
  </body>
</html>
