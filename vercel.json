{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build:tokens && npm run build:icons && npm run build:docs",
  "outputDirectory": "apps/docs/dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/agent/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/llms(.*).txt",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/api/mcp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "functions": {
    "api/mcp.mjs": {
      "includeFiles": "{packages/tokens/dist,packages/ui/src,packages/ui/dist,packages/mcp/src,.canvas}/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/mcp/http",
      "destination": "/api/mcp"
    }
  ]
}
